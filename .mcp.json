{
  "mcpServers": {
    "ccc": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "mcp",
        "run",
        "server.py"
      ],
      "env": {
        "SERVER_ENDPOINT": "YOUR_SERVER_ENDPOINT_HERE",
        "API_KEY": "YOUR_API_KEY_HERE"
      }
    }
  }
}
