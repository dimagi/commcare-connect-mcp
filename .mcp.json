{
  "mcpServers": {
    "ccc": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp[cli]",
        "--with",
        "requests",
        "mcp",
        "run",
        "server.py"
      ],
      "env": {
        "SERVER_ENDPOINT": "https://connect.dimagi.com",
        "API_KEY": "<your-api-key-here>"
      }
    }
  }
}
